{
  "kind": "collectionType",
  "collectionName": "testimonials",
  "info": {
    "singularName": "testimonial",
    "pluralName": "testimonials",
    "displayName": "Testimonials"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "Name": {
      "type": "string",
      "required": true
    },
    "Title": {
      "type": "string"
    },
    "Profile": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Review": {
      "type": "blocks",
      "required": true
    },
    "Rating": {
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 5
    }
  }
}
